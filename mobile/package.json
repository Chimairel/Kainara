{
  "name": "kainara-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "braces": "file:vendor/braces"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:local": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --localhost --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "doctor": "npx expo-doctor",
    "test:native": "jest --runInBand",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:native"
  },
  "private": true,
  "overrides": {
    "braces": "$braces"
  }
}
