# Public configuration only. Never paste database URLs or provider/signing keys.
# Android emulator reaches this laptop through 10.0.2.2. For a physical phone,
# use this laptop's LAN IPv4 address and start the API on an appropriate interface.
# Remote staging must use HTTPS; never default this client to demo for testing.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# Exact staging website origin for Terms/Privacy and unfinished web workflows.
EXPO_PUBLIC_WEB_URL=https://your-staging-site.example
