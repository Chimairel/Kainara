# NutriMind frontend environment template
# Copy this file to .env.local, then fill in any blank values.
# Never put private secrets in NEXT_PUBLIC_* variables; they are visible in the browser.

# Backend REST API base URL. The application also uses this value as its default.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Required only for Google Sign-In.
# Use the same OAuth Web Client ID as backend GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Vercel demo deployment: set NEXT_PUBLIC_API_URL=/api and use Railway's HTTPS
# origin here, without /api. This is evaluated when building the rewrite.
INTERNAL_API_URL=http://127.0.0.1:5000
# Match the backend mode; rebuilding is required when this notice changes.
NUTRIMIND_DEPLOYMENT_MODE=public
