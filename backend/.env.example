# NutriMind backend environment template
# Copy this file to .env, then fill in the blank values.
# Never commit the completed .env file.

# -----------------------------------------------------------------------------
# REQUIRED: PostgreSQL database
# Neon example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/nutrimind?sslmode=require"
# Local example:
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/nutrimind"
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# REQUIRED: Authentication secrets
# Generate each value separately with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED FOR AI FEATURES: Google AI Studio / Gemini
# Create a key at https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Set conservatively at or below the active project's limits shown in AI Studio.
# These are shared across all API processes and all Gemini operations.
GEMINI_PROJECT_MAX_RPM=2
GEMINI_PROJECT_MAX_RPD=40
GEMINI_PROJECT_MAX_ESTIMATED_TPM=50000
GEMINI_PROJECT_MAX_IN_FLIGHT=1
# Keep background meal fills below the overall ceiling so foreground reports
# and user-requested AI features retain project capacity.
GEMINI_BACKGROUND_MAX_RPM=1
GEMINI_BACKGROUND_MAX_RPD=20

# Outside-food AI fair-use quotas.
OUTSIDE_MEAL_AI_DAILY_CAP=5
OUTSIDE_MEAL_AI_30_DAY_CAP=30

# -----------------------------------------------------------------------------
# REQUIRED FOR GOOGLE SIGN-IN
# Use the same OAuth Web Client ID in the frontend .env.local file.
# GOOGLE_CLIENT_SECRET is not used by the current application.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# REQUIRED FOR EMAIL OTP AND PASSWORD RESET
# For Gmail, use an App Password rather than the normal account password.
# Keep SMTP_PASS quoted, especially when the displayed password has spaces.
# EMAIL_FROM is optional for SMTP and falls back to SMTP_USER.
# Railway Free/Trial/Hobby: set EMAIL_PROVIDER=brevo instead of using SMTP.
# Verify a sender in Brevo and create a server-only API key. EMAIL_FROM is
# required for Brevo and must be that verified sender's plain email address.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=""
EMAIL_FROM=

# Optional external connectivity check during API startup. Keep false for local
# development and smoke testing; email delivery still verifies itself when used.
SMTP_VERIFY_ON_STARTUP=false

# Interactive API documentation is available locally at /api/docs. In
# production it remains disabled unless this is explicitly enabled.
API_DOCS_ENABLED=false

# Trust X-Forwarded-* headers only behind the documented Nginx/Caddy topology.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Frontend address used in password-reset email links
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# Comma-separated browser origins allowed to make credentialed API requests.
# Include every deployed frontend origin; local development defaults are shown.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# REQUIRED ONLY FOR /api/cron/* ROUTES
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
CRON_SECRET=

# A nutrition service deployment requires qualified clinical approval.
# A hosted capstone demonstration instead leaves the approval variable unset.
# Keep NODE_ENV=production on hosted demos (secure cookies, limits, logging).
NUTRIMIND_DEPLOYMENT_MODE=public
CLINICAL_POLICY_APPROVED_VERSION=

# -----------------------------------------------------------------------------
# CLOUDINARY MEAL IMAGES — ADMIN UPLOADS ONLY
# Server-side credential URL from the Cloudinary API Keys page. Never expose it
# through NEXT_PUBLIC_* variables or commit the populated value.
# -----------------------------------------------------------------------------
CLOUDINARY_URL=

# -----------------------------------------------------------------------------
# Server defaults for local development
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Base64-encoded 32-byte AES key for private clinical-document encryption.
CLINICAL_DOCUMENT_ENCRYPTION_KEY=

# Apply the additive membership migration before enabling this on a shared host.
# Real purchases remain unavailable. Local test payments use a separate ledger.
MEMBERSHIP_ENABLED=false
MEMBERSHIP_LIFESTYLE_CYCLE_SWAPS=10
MEMBERSHIP_HEALTH_CYCLE_SWAPS=21
MEMBERSHIP_WEEKLY_ESTIMATES=10
MEMBERSHIP_WEEKLY_PLAN_REVIEWS=1
MEMBERSHIP_WEEKLY_OUTSIDE_REVIEWS=1

# PayMongo hosted checkout TEST mode only. Never put these in NEXT_PUBLIC_*.
# Supports regular development databases. Hosted test checkout requires
# NODE_ENV=production plus NUTRIMIND_DEPLOYMENT_MODE=capstone-demo and HTTPS.
# Keep false until the checkout migrations have been applied to the target DB.
PAYMONGO_INTEGRATION_ENABLED=false
PAYMONGO_ENVIRONMENT=TEST
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Return URLs are constructed from FRONTEND_URL; old checkout URL settings are not used.
